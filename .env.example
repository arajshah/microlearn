# Copy this file to ".env" and fill in values as needed.
#   cp .env.example .env
#
# The .env file is git-ignored so secrets never get committed.

# Optional: base URL of the Microlearn control server.
# When unset, the app uses cached content only and cannot generate new material.
# EXPO_PUBLIC_MICROLEARN_API_BASE_URL=http://localhost:3000

# The server bearer token is NOT an env var. Expo inlines EXPO_PUBLIC_* values into the
# client bundle, so the token is entered in the app under Settings and stored in the
# device keychain (expo-secure-store).

# AI provider credentials belong on the server only — see server/.env.example.
# Do NOT put AI API keys in EXPO_PUBLIC_* variables.

# Optional Keycloak OAuth resource-server support for /mcp only. Configure all three
# values together; production issuer and resource URLs must use HTTPS.
# MICROLEARN_OAUTH_ISSUER=https://auth.example.com/realms/microlearn
# MICROLEARN_OAUTH_AUDIENCE=https://api.example.com/mcp
# MICROLEARN_OAUTH_RESOURCE_URL=https://api.example.com/mcp
