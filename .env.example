# Copy this file to ".env" and fill in your own key.
#   cp .env.example .env
#
# Get a free Google AI Studio key: https://aistudio.google.com/apikey
# The .env file is git-ignored so your key never gets committed.

EXPO_PUBLIC_GEMINI_API_KEY=your-google-ai-studio-key-here
EXPO_PUBLIC_AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
EXPO_PUBLIC_AI_MODEL=gemma-4-31b-it

# Optional: base URL of the local Microlearn control server (Phase 4/5).
# When unset, the app uses only local AsyncStorage (unchanged behavior).
# When set, the app can additionally fetch read-only roadmaps from the server.
# EXPO_PUBLIC_MICROLEARN_API_BASE_URL=http://localhost:3000

# The server bearer token is NOT an env var. Expo inlines EXPO_PUBLIC_* values into the
# client bundle, so the token is entered in the app under Settings → Microlearn Server
# and stored in the device keychain (expo-secure-store).

# Optional Keycloak OAuth resource-server support for /mcp only. Configure all three
# values together; production issuer and resource URLs must use HTTPS.
# MICROLEARN_OAUTH_ISSUER=https://auth.example.com/realms/microlearn
# MICROLEARN_OAUTH_AUDIENCE=https://api.example.com/mcp
# MICROLEARN_OAUTH_RESOURCE_URL=https://api.example.com/mcp

# When EXPO_PUBLIC_MICROLEARN_API_BASE_URL is set, Create → Document Link uses
# POST /api/sources/extract for PDF/text/markdown/HTML extraction on the local server.
