{
  "name": "personal-microlearning-app",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "verify:content-v2": "tsx scripts/verify-content-engine-v2.ts",
    "verify:lesson-rendering": "tsx scripts/verify-lesson-rendering.ts",
    "verify:heavy-generation": "tsx scripts/verify-heavy-lesson-generation.ts",
    "verify:adaptive-learning": "tsx scripts/verify-adaptive-learning.ts",
    "verify:api-token": "tsx scripts/verify-api-token.ts",
    "verify:mcp-oauth": "tsx scripts/verify-mcp-oauth.ts",
    "verify:trusted-automation": "tsx scripts/verify-trusted-automation.ts",
    "verify:review-integrity": "tsx scripts/verify-review-integrity.ts",
    "verify:server-generation": "tsx scripts/verify-server-generation.ts",
    "verify:generation-quality": "tsx scripts/verify-generation-quality.ts",
    "repair:review-integrity": "tsx scripts/repair-review-integrity.ts",
    "reset:learning": "tsx scripts/reset-learning-data.ts learning",
    "reset:all-data": "tsx scripts/reset-learning-data.ts all",
    "server:dev": "tsx server/src/index.ts",
    "server:start": "node server/dist/index.js",
    "server:worker": "tsx server/src/worker.ts",
    "server:worker:start": "node server/dist/worker.js",
    "server:build": "tsc -p server/tsconfig.json",
    "server:typecheck": "tsc -p server/tsconfig.json --noEmit",
    "server:tunnel": "cloudflared tunnel --url http://localhost:3000"
  },
  "dependencies": {
    "@expo/metro-runtime": "~6.1.2",
    "@expo/vector-icons": "^15.1.1",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "better-sqlite3": "^12.11.1",
    "dotenv": "^17.4.2",
    "expo": "~54.0.34",
    "expo-constants": "~18.0.13",
    "expo-document-picker": "~14.0.8",
    "expo-font": "~14.0.12",
    "expo-haptics": "~15.0.8",
    "expo-linear-gradient": "~15.0.8",
    "expo-linking": "~8.0.12",
    "expo-notifications": "^0.32.17",
    "expo-router": "~6.0.24",
    "expo-secure-store": "~15.0.8",
    "expo-speech": "~14.0.8",
    "expo-status-bar": "~3.0.9",
    "express": "^5.2.1",
    "jose": "^6.2.3",
    "pdf-parse": "^2.4.5",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "^15.12.1",
    "react-native-web": "^0.21.0",
    "react-native-worklets": "^0.5.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/express": "^5.0.6",
    "@types/node": "^26.1.0",
    "@types/react": "~19.1.0",
    "babel-preset-expo": "~54.0.11",
    "tsx": "^4.23.0",
    "typescript": "~5.9.2"
  },
  "private": true
}
