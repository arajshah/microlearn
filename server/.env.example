# Microlearn local control server (Phase 1)
# Copy to ".env" at the repo root (or export in your shell) to override defaults.
# The .env file is git-ignored so nothing sensitive gets committed.

# development | production | test
NODE_ENV=development

# Port for the local backend server (separate from the Expo dev server).
MICROLEARN_SERVER_PORT=3000

# Path to the local SQLite database, relative to the repo root.
MICROLEARN_DB_PATH=server/data/microlearn.local.db

# Public tunnel URL used manually during development (Cloudflare Quick Tunnel).
# Quick Tunnel URLs are temporary — do not commit real temporary tunnel URLs.
# MICROLEARN_TUNNEL_URL=https://example.trycloudflare.com

# Optional absolute repo root for MCP repo-inspection tools. Defaults to process.cwd().
# Do not commit a real local path.
# MICROLEARN_REPO_ROOT=/path/to/Microlearn
