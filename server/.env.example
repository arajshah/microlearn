# Microlearn local control server (Phase 1)
# Copy to ".env" at the repo root (or export in your shell) to override defaults.
# The .env file is git-ignored so nothing sensitive gets committed.

# development | production | test
NODE_ENV=development

# Port for the local backend server (separate from the Expo dev server).
MICROLEARN_SERVER_PORT=3000

# Path to the local SQLite database, relative to the repo root.
MICROLEARN_DB_PATH=server/data/microlearn.local.db

# Public tunnel URL used manually during development (Cloudflare Quick Tunnel).
# Quick Tunnel URLs are temporary — do not commit real temporary tunnel URLs.
# MICROLEARN_TUNNEL_URL=https://example.trycloudflare.com

# Optional absolute repo root for MCP repo-inspection tools. Defaults to process.cwd().
# Do not commit a real local path.
# MICROLEARN_REPO_ROOT=/path/to/Microlearn

# --- Phase 4/5 write-tool safety flags (default false) ---
# Enable write-capable MCP tools (create_file, apply_patch, move/delete/restore, git write).
# Read-only tools always work regardless of this flag.
MICROLEARN_ENABLE_WRITE_TOOLS=false

# Allow the push_branch MCP tool to run. Requires MICROLEARN_ENABLE_WRITE_TOOLS=true as well.
MICROLEARN_ENABLE_GIT_PUSH=false

# --- Phase 7 optional local-development auth (default false) ---
# When true, /mcp and /api/* require bearer tokens (see below). /health stays public.
MICROLEARN_REQUIRE_AUTH=false
# Required when MICROLEARN_REQUIRE_AUTH=true. Never commit real tokens.
# MICROLEARN_MCP_BEARER_TOKEN=your-mcp-token
# MICROLEARN_API_BEARER_TOKEN=your-api-token

# --- Phase 4 document source extraction ---
# Public http(s) URLs only. Upload is not implemented server-side yet.
# Max download 15 MB, timeout 20 s. Extraction is synchronous on POST /api/sources/extract.

# --- Server-side AI generation (required for /api/generation/*) ---
# Provider credentials stay on the server — never expose them to the Expo client.
# MICROLEARN_AI_PROVIDER=openai-compatible
# MICROLEARN_AI_API_KEY=your-provider-api-key
# MICROLEARN_AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# MICROLEARN_AI_MODEL=gemma-4-31b-it
# MICROLEARN_AI_TIMEOUT_MS=45000
# Use MICROLEARN_AI_PROVIDER=fake for deterministic local verification (no network).
